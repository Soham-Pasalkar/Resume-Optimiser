# ==============================================================================
# CareerPilot — Environment Configuration Template
# Copy to .env for local configuration: cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="CareerPilot"
API_V1_STR="/api/v1"

# Security & Authentication (Generate random secret: openssl rand -hex 32)
SECRET_KEY="careerpilot-super-secret-development-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings (Comma-separated allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (PostgreSQL 16 + pgvector)
# For local host development:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/careerpilot"
# For Docker Compose networking:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/careerpilot"

# Redis Cache & Background Queue
REDIS_URL="redis://localhost:6379/0"
# For Docker Compose:
# REDIS_URL="redis://redis:6379/0"

# Local AI / Ollama Engine (100% Free Operational Mode)
# Host machine Ollama endpoint:
OLLAMA_BASE_URL="http://localhost:11434"
# When running backend inside Docker container, use:
# OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_DEFAULT_MODEL="llama3.1:8b"
OLLAMA_FALLBACK_MODEL="llama3.2:3b"
OLLAMA_TIMEOUT_SECONDS=60

# Optional BYOK Cloud LLM Keys (Leave empty for 100% free local Ollama mode)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Document Storage (MinIO / S3)
STORAGE_BACKEND="local" # "local" or "s3"
LOCAL_STORAGE_DIR="./storage_data"
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="careerpilot-documents"

# Embeddings Model (Local Sentence Transformers)
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"

# Frontend Configuration (Exposed to browser)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_APP_ENV="development"
